cmake_minimum_required(VERSION 3.25)

# Lock the actual linked executable and its redistributable notices.
execute_process(COMMAND "${LINKER}" /dump /dependents "${PLAYER}"
  RESULT_VARIABLE status OUTPUT_VARIABLE dependencies ERROR_VARIABLE diagnostics)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Could not read the Windows player dependencies: ${diagnostics}")
endif()
string(TOLOWER "${dependencies}" dependencies)
string(REGEX MATCHALL "[a-z0-9_.-]+[.]dll" imports "${dependencies}")
list(REMOVE_DUPLICATES imports)
list(SORT imports)
if(NOT "kernel32.dll" IN_LIST imports)
  message(FATAL_ERROR "The Windows player import table could not be read.")
endif()
set(windows_dlls advapi32.dll bcrypt.dll comdlg32.dll dwmapi.dll gdi32.dll imm32.dll
  kernel32.dll ntdll.dll ole32.dll oleaut32.dll opengl32.dll shell32.dll shcore.dll
  user32.dll version.dll winmm.dll)
set(dlls)
foreach(dll IN LISTS imports)
  if(NOT dll IN_LIST windows_dlls)
    message(FATAL_ERROR "Unexpected player dependency ${dll}. The runtime must link its CRT and graphics backend statically.")
  endif()
  list(APPEND dlls "\"${dll}\"")
endforeach()
list(JOIN dlls ", " dll_json)
file(READ "${SPEC}" metadata)
string(JSON metadata SET "${metadata}" system_dlls "[${dll_json}]")
string(JSON metadata SET "${metadata}" msvc "\"${TOOLCHAIN}\"")

file(MAKE_DIRECTORY "${OUTPUT}/licenses")
file(COPY_FILE "${PLAYER}" "${OUTPUT}/Play.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${REPO}/LICENSE" "${OUTPUT}/licenses/wds.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${REPO}/third_party/nlohmann/LICENSE.MIT" "${OUTPUT}/licenses/nlohmann-json.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${REPO}/third_party/lodepng/LICENSE" "${OUTPUT}/licenses/lodepng.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${RAYLIB}/LICENSE" "${OUTPUT}/licenses/raylib.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${RAYLIB}/src/external/glfw/LICENSE.md" "${OUTPUT}/licenses/glfw.txt" ONLY_IF_DIFFERENT)

function(read_notice source first last output)
  file(READ "${RAYLIB}/src/external/${source}" text)
  string(FIND "${text}" "${first}" start)
  if(start LESS 0)
    message(FATAL_ERROR "Missing license text in raylib's ${source}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 text)
  string(FIND "${text}" "${last}" end)
  if(end LESS 0)
    message(FATAL_ERROR "Incomplete license text in raylib's ${source}")
  endif()
  string(SUBSTRING "${text}" 0 ${end} notice)
  set(${output} "${notice}" PARENT_SCOPE)
endfunction()

read_notice(glad.h "** Copyright (c) 2008-2018 The Khronos Group Inc." "*/" khronos)
read_notice(stb_image_resize2.h "ALTERNATIVE A - MIT License" "ALTERNATIVE B" stb)
read_notice(rl_gputex.h "*   LICENSE: zlib/libpng" "*/" gputex)
file(WRITE "${OUTPUT}/licenses/raylib-embedded.txt"
  "GLAD generated types\n${khronos}\n\nstb_image_resize2\n${stb}\n\nrl_gputex\n${gputex}\n")

set(files "[]")
set(index 0)
foreach(path IN ITEMS Play.exe licenses/wds.txt licenses/nlohmann-json.txt licenses/lodepng.txt
    licenses/raylib.txt licenses/glfw.txt licenses/raylib-embedded.txt)
  file(SIZE "${OUTPUT}/${path}" bytes)
  file(SHA256 "${OUTPUT}/${path}" sha256)
  string(JSON files SET "${files}" ${index}
    "{\"path\": \"${path}\", \"bytes\": ${bytes}, \"sha256\": \"${sha256}\"}")
  math(EXPR index "${index}+1")
endforeach()
string(JSON metadata SET "${metadata}" files "${files}")
file(WRITE "${OUTPUT}/wds.runtime.json" "${metadata}\n")
