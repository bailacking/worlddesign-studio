/*
 * Qt 工作台全局皮肤。theme.cpp 用 colors.inc 中的颜色值替换 @名称@ 后加载。
 * 选中、焦点、禁用和状态颜色对应工作台规范。
 * 保持系统字体、键盘焦点提示与原生控件交互。
 */
/* ---------- 通用 ---------- */

QWidget {
    color: @text@;
}

QWidget:disabled {
    color: @disabled_text@;
}

QMainWindow,
QDialog {
    background-color: @window@;
}

/* 焦点一律用边框表达：常态 1px 透明，聚焦时换色，避免出现焦点时控件位移。 */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QPushButton,
QToolButton,
QAbstractItemView,
QTabBar::tab {
    outline: 0;
}

/* ---------- 工具栏 ---------- */

QToolBar {
    background-color: @button@;
    border: 0;
    border-bottom: 1px solid @border@;
    padding: 2px;
    spacing: 2px;
}

QToolBar::separator {
    background-color: @border@;
    width: 1px;
    margin: 4px 5px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: @text@;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 6px;
}

QToolBar QToolButton:hover {
    background-color: @hover@;
    border-color: @border@;
}

QToolBar QToolButton:pressed {
    background-color: @alternate@;
}

QToolBar QToolButton:checked {
    background-color: @selected@;
    color: @selected_text@;
}

QToolBar QToolButton:checked:hover {
    background-color: @selected_hover@;
}

QToolBar QToolButton:focus {
    border-color: @focus@;
}

QToolBar QToolButton:disabled {
    background-color: transparent;
    border-color: transparent;
    color: @disabled_text@;
}

/* ---------- 菜单 ---------- */

QMenuBar {
    background-color: @button@;
    border-bottom: 1px solid @border@;
    padding: 1px 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 9px;
    border: 1px solid transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: @hover@;
}

QMenuBar::item:pressed {
    background-color: @selected@;
    color: @selected_text@;
}

QMenuBar::item:disabled {
    color: @disabled_text@;
}

QMenu {
    background-color: @panel@;
    border: 1px solid @border@;
    padding: 4px 2px;
}

QMenu::item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 26px 5px 24px;
}

QMenu::item:selected {
    background-color: @selected@;
    color: @selected_text@;
}

QMenu::item:disabled {
    background-color: transparent;
    color: @disabled_text@;
}

QMenu::separator {
    background-color: @border@;
    height: 1px;
    margin: 4px 8px;
}

/* ---------- 主窗口与停靠 ---------- */

QMainWindow::separator {
    background-color: @input@;
    width: 4px;
    height: 4px;
}

QMainWindow::separator:hover,
QMainWindow::separator:pressed {
    background-color: @focus@;
}

QDockWidget {
    color: @text@;
}

QDockWidget::title {
    background-color: @button@;
    border-bottom: 1px solid @border@;
    padding: 5px 8px;
    text-align: left;
}

QSplitter::handle {
    background-color: @input@;
}

QSplitter::handle:hover {
    background-color: @focus@;
}

/* ---------- 树、列表、表格 ---------- */

QTreeView,
QListView,
QTableView,
QColumnView {
    background-color: @input@;
    alternate-background-color: @alternate@;
    border: 1px solid @input_border@;
    border-radius: 3px;
    color: @text@;
    selection-background-color: @selected@;
    selection-color: @selected_text@;
}

QTreeView:focus,
QListView:focus,
QTableView:focus,
QColumnView:focus {
    border-color: @focus@;
}

QTreeView::item,
QListView::item,
QTableView::item,
QColumnView::item {
    padding: 2px 4px;
    border: 1px solid transparent;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover,
QColumnView::item:hover {
    background-color: @hover@;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected,
QColumnView::item:selected {
    background-color: @selected@;
    color: @selected_text@;
}

QTreeView::item:selected:hover,
QListView::item:selected:hover,
QTableView::item:selected:hover,
QColumnView::item:selected:hover {
    background-color: @selected_hover@;
}

/* 窗口失焦时保留选中位置，降低饱和度，与键盘焦点所在面板区分。 */
QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active,
QColumnView::item:selected:!active {
    background-color: @selected_inactive@;
    color: @text@;
}

QTreeView::item:disabled,
QListView::item:disabled,
QTableView::item:disabled {
    color: @disabled_text@;
}

QHeaderView {
    background-color: @panel@;
}

QHeaderView::section {
    background-color: @panel@;
    color: @secondary_text@;
    border: 0;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: 4px 6px;
}

QHeaderView::section:hover {
    background-color: @hover@;
    color: @text@;
}

/* ---------- 页签 ---------- */

QTabWidget::pane {
    background-color: @window@;
    border: 1px solid @border@;
    border-radius: 3px;
    top: -1px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: @panel@;
    color: @secondary_text@;
    border: 1px solid @border@;
    border-bottom: 2px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 5px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: @hover@;
    color: @text@;
}

QTabBar::tab:selected {
    background-color: @window@;
    color: @text@;
    border-top-color: @focus@;
}

QTabBar::tab:disabled {
    color: @disabled_text@;
    background-color: @alternate@;
}

/* ---------- 输入 ---------- */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: @input@;
    color: @text@;
    border: 1px solid @input_border@;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: @selected@;
    selection-color: @selected_text@;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: @disabled_text@;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: @focus@;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: @alternate@;
    border-color: @border@;
    color: @disabled_text@;
}

/* 只读展示（修订号、资源路径等）：可读但不与可编辑输入竞争视觉重量。 */
QLineEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"],
QTextEdit[readOnly="true"] {
    background-color: @alternate@;
    border-color: @border@;
    color: @light_border@;
}

/* 校验失败的输入：边框与文本同时换色，不依赖底色深浅。 */
QLineEdit[state="failed"],
QPlainTextEdit[state="failed"],
QTextEdit[state="failed"],
QComboBox[state="failed"],
QSpinBox[state="failed"],
QDoubleSpinBox[state="failed"] {
    border-color: @error@;
    color: @error@;
}

/* ---------- 按钮 ---------- */

QPushButton {
    background-color: @pressed@;
    color: @text@;
    border: 1px solid @input_border@;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: @hover@;
    border-color: @disabled_text@;
}

QPushButton:pressed {
    background-color: @alternate@;
}

QPushButton:checked {
    background-color: @selected@;
    border-color: @focus@;
    color: @selected_text@;
}

QPushButton:default {
    border-color: @slider@;
}

QPushButton:focus {
    border-color: @focus@;
}

QPushButton:disabled {
    background-color: @panel_edge@;
    border-color: @border@;
    color: @disabled_text@;
}

QPushButton[state="modified"] {
    border-color: @warning@;
    color: @warning_text@;
}

QPushButton[state="failed"] {
    border-color: @error@;
    color: @error@;
}

QPushButton[state="running"] {
    border-color: @running@;
    color: @running@;
}

QToolButton {
    background-color: transparent;
    color: @text@;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 5px;
}

QToolButton:hover {
    background-color: @hover@;
}

QToolButton:pressed {
    background-color: @alternate@;
}

QToolButton:checked {
    background-color: @selected@;
    color: @selected_text@;
}

QToolButton:focus {
    border-color: @focus@;
}

QToolButton:disabled {
    color: @disabled_text@;
    background-color: transparent;
}

QToolButton[state="running"] {
    border-color: @running@;
    color: @running@;
}

QToolButton[state="failed"] {
    border-color: @error@;
    color: @error@;
}

/* 勾选框与单选框的指示器由 style 按调色板绘制，此处不改背景，只补键盘焦点环。 */
QCheckBox,
QRadioButton {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 1px 2px;
    color: @text@;
}

QCheckBox:focus,
QRadioButton:focus {
    border-color: @focus@;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: @disabled_text@;
}

QGroupBox {
    border: 1px solid @border@;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: @secondary_text@;
}

/* ---------- 滚动条与进度 ---------- */

QScrollBar:vertical {
    background-color: transparent;
    border: 0;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @border@;
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: @scroll_thumb@;
}

QScrollBar::handle:vertical:pressed {
    background-color: @focus@;
}

QScrollBar::handle:vertical:disabled {
    background-color: @pressed@;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: 0;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @border@;
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @scroll_thumb@;
}

QScrollBar::handle:horizontal:pressed {
    background-color: @focus@;
}

QScrollBar::handle:horizontal:disabled {
    background-color: @pressed@;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QProgressBar {
    background-color: @input@;
    border: 1px solid @input_border@;
    border-radius: 3px;
    color: @text@;
    text-align: center;
}

QProgressBar::chunk {
    background-color: @running@;
    border-radius: 2px;
}

/* ---------- 状态栏与提示 ---------- */

QStatusBar {
    background-color: @button@;
    border-top: 1px solid @border@;
    color: @secondary_text@;
}

QStatusBar::item {
    border: 0;
}

QStatusBar QLabel {
    color: @secondary_text@;
    padding: 0 6px;
}

QToolTip {
    background-color: @pressed@;
    color: @text@;
    border: 1px solid @input_border@;
    border-radius: 3px;
    padding: 3px 6px;
}

/* ---------- 状态属性 ---------- */

QLabel[state="idle"] {
    color: @secondary_text@;
}

QLabel[state="modified"] {
    color: @warning@;
}

QLabel[state="failed"] {
    color: @error@;
}

QLabel[state="running"] {
    color: @running@;
}

QLabel[state="empty"] {
    color: @empty_text@;
}

/* 资源路径、修订号等次级信息：保留完整对比度，长文本不压缩字距。 */
QLabel[path="true"] {
    color: @secondary_text@;
}

QLabel[path="true"]:disabled {
    color: @disabled_text@;
}

/* 面板级状态：给容器一条状态色外框，便于在多个停靠面板间定位。 */
QFrame[state="modified"] {
    border: 1px solid @warning@;
    border-radius: 3px;
}

QFrame[state="failed"] {
    border: 1px solid @error@;
    border-radius: 3px;
}

QFrame[state="running"] {
    border: 1px solid @running@;
    border-radius: 3px;
}
