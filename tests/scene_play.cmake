function(play expected revision ticks)
  execute_process(
    COMMAND "${CLI}" project play "${project}" "${revision}" "${ticks}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE detail
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

string(RANDOM LENGTH 12 nonce)
set(project "${ROOT}/试跑 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${project}")
set(scene "${project}/assets/motion.json")
file(SHA256 "${scene}" scene_before)
file(SHA256 "${project}/wds.project.json" manifest_before)
play(ok 0 30)
string(JSON x GET "${result}" entities 1 x)
string(JSON y GET "${result}" entities 1 y)
string(JSON vy GET "${result}" entities 0 vy)
string(JSON ticks GET "${result}" ticks)
if(NOT x EQUAL -230 OR NOT y EQUAL -25 OR NOT vy EQUAL 0 OR NOT ticks EQUAL 30)
  message(FATAL_ERROR "Unexpected runtime snapshot: ${result}")
endif()
set(snapshot "${result}")
play(ok 0 30)
if(NOT result STREQUAL snapshot)
  message(FATAL_ERROR "Restart returned a different snapshot: ${result}")
endif()
play(ok 0 0)
string(JSON x GET "${result}" entities 1 x)
if(NOT x EQUAL -260)
  message(FATAL_ERROR "Restart retained runtime state: ${result}")
endif()
play(ok 0 600)
play(invalid_argument 0 601)
play(invalid_argument 0 -1)
play(revision_conflict 1 0)
string(JSON revision GET "${result}" revision)
if(NOT revision EQUAL 0)
  message(FATAL_ERROR "Conflict omitted the current revision: ${result}")
endif()
file(SHA256 "${scene}" scene_after)
file(SHA256 "${project}/wds.project.json" manifest_after)
if(NOT scene_before STREQUAL scene_after OR NOT manifest_before STREQUAL manifest_after)
  message(FATAL_ERROR "Preview modified source files")
endif()

file(WRITE "${scene}" "{}\n")
play(ok 0 0)
string(JSON count LENGTH "${result}" entities)
if(NOT count EQUAL 0)
  message(FATAL_ERROR "Legacy empty scene was not empty: ${result}")
endif()
file(WRITE "${scene}" [=[{"format_version":2,"entities":[]}]=])
play(unsupported_scene_version 0 0)
file(WRITE "${scene}" [=[{"format_version":1,"entities":[{"id":"a"},{"id":"a"}]}]=])
play(duplicate_entity_id 0 0)
string(JSON location GET "${result}" location)
string(JSON path GET "${result}" resource_path)
if(NOT location STREQUAL "/entities/1/id" OR NOT path STREQUAL "assets/motion.json")
  message(FATAL_ERROR "Duplicate entity diagnostic omitted its location: ${result}")
endif()
file(WRITE "${scene}" [=[{"format_version":1,"entities":[{"id":"a","vx":18446744073709551615}]}]=])
play(invalid_scene 0 0)
file(WRITE "${scene}" [=[{"format_version":1,"entities":[{"id":"a","x":0.5}]}]=])
play(invalid_scene 0 0)
file(WRITE "${scene}" [=[{"format_version":1,"entities":[{"id":"a","x":0,"x":1}]}]=])
play(invalid_scene 0 0)
file(WRITE "${scene}" [=[{"format_version":1,"entities":[{"id":"a","parent":"b"}]}]=])
play(invalid_scene 0 0)
string(REPEAT " " 1048577 oversized)
file(WRITE "${scene}" "${oversized}")
play(scene_too_large 0 0)

set(project "${ROOT}/new-${nonce}")
execute_process(COMMAND "${CLI}" project create "${project}" empty-scene RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Could not create a new project")
endif()
play(ok 0 0)
string(JSON count LENGTH "${result}" entities)
if(NOT count EQUAL 0)
  message(FATAL_ERROR "New project scene was not empty: ${result}")
endif()

set(scene "${project}/assets/intro.json")
file(WRITE "${scene}" "{}\n")
file(SHA256 "${scene}" original_bytes)
execute_process(
  COMMAND "${CLI}" project edit-entity "${project}" add marker 0 --capture-change
  RESULT_VARIABLE status OUTPUT_VARIABLE result)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Could not record an entity edit: ${result}")
endif()
string(JSON change GET "${result}" scene_change)
# Quotes and escaped newlines stay inside the JSON literal.
string(REGEX MATCH "\"before\"[ \n\r]*:[ \n\r]*(\"([^\"\\\\]|\\\\.)*\")" before_match "${change}")
set(before "${CMAKE_MATCH_1}")
string(REGEX MATCH "\"after\"[ \n\r]*:[ \n\r]*(\"([^\"\\\\]|\\\\.)*\")" after_match "${change}")
set(after "${CMAKE_MATCH_1}")
string(JSON undo SET "${change}" before "${after}")
string(JSON undo SET "${undo}" after "${before}")
set(request "${ROOT}/restore-${nonce}.json")
file(WRITE "${request}" "${undo}")

file(COPY_FILE "${scene}" "${request}.saved")
file(APPEND "${scene}" " ")
file(SHA256 "${scene}" externally_edited_bytes)
execute_process(
  COMMAND "${CLI}" project restore-scene "${project}" 1
  INPUT_FILE "${request}" RESULT_VARIABLE status OUTPUT_VARIABLE result)
string(JSON code GET "${result}" code)
file(SHA256 "${scene}" actual_bytes)
if(NOT status STREQUAL "1" OR NOT code STREQUAL "scene_content_conflict" OR
   NOT actual_bytes STREQUAL externally_edited_bytes)
  message(FATAL_ERROR "Restore did not preserve an external edit: ${result}")
endif()
file(COPY_FILE "${request}.saved" "${scene}")
execute_process(
  COMMAND "${CLI}" project restore-scene "${project}" 1
  INPUT_FILE "${request}" RESULT_VARIABLE status OUTPUT_VARIABLE result)
file(SHA256 "${scene}" actual_bytes)
if(NOT status STREQUAL "0" OR NOT actual_bytes STREQUAL original_bytes)
  message(FATAL_ERROR "Undo did not restore the original scene bytes: ${result}")
endif()
file(WRITE "${request}" "${change}")
execute_process(
  COMMAND "${CLI}" project restore-scene "${project}" 2
  INPUT_FILE "${request}" RESULT_VARIABLE status OUTPUT_VARIABLE result)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Redo did not restore the edited scene: ${result}")
endif()
play(ok 3 0)
string(JSON id GET "${result}" entities 0 id)
if(NOT id STREQUAL "marker")
  message(FATAL_ERROR "Redo did not bring back the entity: ${result}")
endif()
