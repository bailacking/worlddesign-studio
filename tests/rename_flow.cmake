if(NOT DEFINED CLI OR NOT DEFINED ROOT)
  message(FATAL_ERROR "CLI and ROOT are required")
endif()

function(check_run expected pattern)
  execute_process(
    COMMAND "${CLI}" "${ROOT}" ${ARGN}
    RESULT_VARIABLE code
    OUTPUT_VARIABLE output
    ERROR_VARIABLE detail
  )
  if(NOT code STREQUAL expected OR NOT output MATCHES "${pattern}")
    message(FATAL_ERROR "Expected ${expected}, ${pattern}; got ${code}: ${output} ${detail}")
  endif()
endfunction()

set(manifest "${ROOT}/.wds-project")
set(journal "${ROOT}/.wds-rename")
set(old "${ROOT}/assets/tile.txt")
set(new "${ROOT}/assets/stone.txt")
set(before "wds-project-v1 0\nA assets/scene.txt B\nB assets/tile.txt\n")
set(after "wds-project-v1 1\nA assets/scene.txt B\nB assets/stone.txt\n")

function(seed)
  file(MAKE_DIRECTORY "${ROOT}/assets")
  file(REMOVE "${new}" "${journal}")
  file(WRITE "${ROOT}/assets/scene.txt" "ref:B")
  file(WRITE "${old}" "hello")
  file(WRITE "${manifest}" "${before}")
endfunction()

function(check_manifest expected)
  file(READ "${manifest}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected manifest: ${actual}")
  endif()
endfunction()

seed()
check_run(0 "ok revision=0" open)
check_run(0 "ok revision=0 changed=false" asset.rename B tile.txt 0)
check_run(1 "path_conflict revision=0" asset.rename B TILE.txt 0)
check_run(1 "path_conflict revision=0" asset.rename B scene.txt 0)
check_run(1 "invalid_argument" asset.rename B ../escape 0)
check_run(1 "invalid_argument" asset.rename B CON.txt 0)
check_run(1 "asset_not_found revision=0" asset.rename C stone.txt 0)
check_run(0 "ok revision=1 changed=true" asset.rename B stone.txt 0)
check_run(1 "revision_conflict revision=1" asset.rename B other.txt 0)
check_run(0 "ok revision=1" open)
check_manifest("${after}")
file(READ "${new}" bytes)
if(EXISTS "${old}" OR NOT bytes STREQUAL "hello")
  message(FATAL_ERROR "Rename changed source bytes or left the old file")
endif()

if(DEFINED GUI)
  seed()
  execute_process(COMMAND "${GUI}" --verify "${ROOT}" RESULT_VARIABLE gui_code)
  if(NOT gui_code STREQUAL "0")
    message(FATAL_ERROR "Windows GUI actions failed: ${gui_code}")
  endif()
  check_run(0 "ok revision=1" open)
  check_manifest("${after}")
  file(READ "${new}" gui_bytes)
  if(EXISTS "${old}" OR NOT gui_bytes STREQUAL bytes)
    message(FATAL_ERROR "GUI and CLI changed different source data")
  endif()
endif()

# Force a real failure at the manifest staging step, after the source move.
seed()
file(MAKE_DIRECTORY "${manifest}.tmp")
check_run(1 "save_failed revision=0" asset.rename B stone.txt 0)
file(REMOVE_RECURSE "${manifest}.tmp")
check_manifest("${before}")
if(NOT EXISTS "${old}" OR EXISTS "${new}" OR EXISTS "${journal}")
  message(FATAL_ERROR "Failed save did not restore the original path")
endif()

# Simulate files left by a process interrupted after moving the source.
# The last field is the FNV-1a checksum of the five bytes 'hello'.
set(record "wds-rename-v1 0 B assets/tile.txt assets/stone.txt 11831194018420276491\n")
seed()
file(RENAME "${old}" "${new}")
file(WRITE "${journal}" "${record}")
check_run(1 "recovery_required revision=0" asset.rename B other.txt 0)
check_run(0 "ok revision=0" open)
check_run(0 "ok revision=0" open)
if(NOT EXISTS "${old}" OR EXISTS "${new}" OR EXISTS "${journal}")
  message(FATAL_ERROR "Reopen did not roll back the uncommitted move")
endif()

file(RENAME "${old}" "${new}")
file(WRITE "${manifest}" "${after}")
file(WRITE "${journal}" "${record}")
check_run(0 "ok revision=1" open)
check_run(0 "ok revision=1" open)
if(EXISTS "${old}" OR NOT EXISTS "${new}" OR EXISTS "${journal}")
  message(FATAL_ERROR "Reopen did not preserve the committed move")
endif()

file(WRITE "${old}" "do not overwrite")
file(WRITE "${journal}" "${record}")
check_run(1 "recovery_required revision=1" open)
file(READ "${old}" unexpected)
if(NOT unexpected STREQUAL "do not overwrite" OR NOT EXISTS "${new}" OR NOT EXISTS "${journal}")
  message(FATAL_ERROR "Conflicting files must be preserved")
endif()

seed()
file(APPEND "${manifest}" "B assets/extra.txt\n")
check_run(1 "recovery_required" open)
