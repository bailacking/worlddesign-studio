cmake_minimum_required(VERSION 3.25)

function(quote output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(result_of expected)
  set(options ${ARGN})
  execute_process(
    COMMAND "${CLI}" project ${options}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE detail ENCODING UTF-8
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

function(request expected input)
  set(options ${ARGN})
  file(WRITE "${request_file}" "${input}")
  execute_process(
    COMMAND "${CLI}" project request "${project}" ${options}
    INPUT_FILE "${request_file}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE detail
    ENCODING UTF-8
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

function(convert from to document)
  set(request [=[{"operation":"behavior.convert","version":1,"mode":"read"}]=])
  string(JSON input SET "{}" from "\"${from}\"")
  string(JSON input SET "${input}" to "\"${to}\"")
  string(JSON input SET "${input}" document "${document}")
  string(JSON request SET "${request}" input "${input}")
  request(ok "${request}")
  set(conversion "${result}" PARENT_SCOPE)
endfunction()

function(play revision snapshot ticks speed x)
  result_of(ok play "${project}" "${revision}" "${ticks}")
  string(JSON actual_speed GET "${result}" behavior_state speed)
  string(JSON actual_x GET "${result}" entities 1 x)
  if(NOT actual_speed EQUAL speed OR NOT actual_x EQUAL x)
    message(FATAL_ERROR "Expected speed=${speed}, x=${x}: ${result}")
  endif()
  string(JSON without_revision REMOVE "${result}" revision)
  set(${snapshot} "${without_revision}" PARENT_SCOPE)
endfunction()

function(restore revision after)
  file(READ "${scene}" before)
  quote(before "${before}")
  quote(after "${after}")
  set(change [=[{"project_id":"shared-behavior","scene_id":"glide","resource_path":"assets/glide.json"}]=])
  string(JSON change SET "${change}" before "${before}")
  string(JSON change SET "${change}" after "${after}")
  set(request [=[{"operation":"scene.restore","version":1,"mode":"apply","input":{}}]=])
  string(JSON request SET "${request}" expected_revision "${revision}")
  string(JSON request SET "${request}" input change "${change}")
  request(ok "${request}" --allow-project-write)
endfunction()

string(RANDOM LENGTH 12 nonce)
set(project "${ROOT}/w11-${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${project}")
set(request_file "${ROOT}/request-${nonce}.json")
set(scene "${project}/assets/glide.json")
file(READ "${scene}" original)
string(JSON code GET "${original}" behavior document)
quote(code_literal "${code}")

play(0 start 0 2 -100)
play(0 code_snapshot 5 8 -66)
convert(code graph "${code_literal}")
string(JSON graph GET "${conversion}" document)
string(JSON graph_scene SET "${original}" behavior format "\"graph\"")
string(JSON graph_scene SET "${graph_scene}" behavior document "${graph}")
restore(0 "${graph_scene}\n")
play(1 graph_snapshot 5 8 -66)
if(NOT code_snapshot STREQUAL graph_snapshot)
  message(FATAL_ERROR "Code and graph produced different scenes:\n${code_snapshot}\n${graph_snapshot}")
endif()

convert(graph code "${graph}")
string(JSON roundtrip GET "${conversion}" document)
if(NOT roundtrip STREQUAL code)
  message(FATAL_ERROR "Supported sample did not round-trip to the same code")
endif()
# Edit the graph's cruise parameter, convert to code and reopen the saved scene.
string(JSON edited_graph SET "${graph}" nodes 2 value 6)
convert(graph code "${edited_graph}")
string(JSON edited_code GET "${conversion}" document)
quote(edited_code "${edited_code}")
string(JSON edited_scene SET "${original}" behavior document "${edited_code}")
restore(1 "${edited_scene}\n")
play(2 edited 5 6 -72)
message(STATUS "Start speed 2. Code and graph after 5 steps: speed 8, x=-66. After graph edit: speed 6, x=-72.")

# An unsupported line is retained byte-for-byte, including its CRLF, and cannot execute.
set(opaque_line "after collision { call(42); }\r\n")
set(opaque_code "${code}${opaque_line}")
quote(opaque_literal "${opaque_code}")
convert(code graph "${opaque_literal}")
string(JSON opaque GET "${conversion}" opaque 0)
if(NOT opaque STREQUAL "/document/line/7")
  message(FATAL_ERROR "Missing unsupported line diagnostic")
endif()
string(JSON opaque_graph GET "${conversion}" document)
convert(graph code "${opaque_graph}")
string(JSON restored_code GET "${conversion}" document)
if(NOT restored_code STREQUAL opaque_code)
  message(FATAL_ERROR "Unsupported source bytes changed")
endif()
string(JSON broken SET "${original}" behavior document "${opaque_literal}")
file(WRITE "${scene}" "${broken}")
result_of(unsupported_behavior play "${project}" 2 5)
string(JSON where GET "${result}" location)
if(NOT where STREQUAL "/behavior/document/line/7")
  message(FATAL_ERROR "Unsupported runtime diagnostic points to ${where}")
endif()
message(STATUS "Unsupported line survives a CRLF round-trip and is rejected in play.")
