string(RANDOM LENGTH 12 nonce)
set(project "${ROOT}/${nonce}/请求 工程")
file(COPY "${EXAMPLE}/" DESTINATION "${project}")
set(payload "${ROOT}/${nonce}/input.json")

function(request expected body)
  file(WRITE "${payload}" "${body}")
  execute_process(COMMAND "${CLI}" project request "${project}" ${ARGN}
    INPUT_FILE "${payload}" RESULT_VARIABLE status OUTPUT_VARIABLE result ENCODING UTF-8)
  string(JSON code ERROR_VARIABLE invalid GET "${result}" code)
  if(invalid OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${result}")
  endif()
  string(JSON count GET "${result}" usage requests)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one measured request: ${result}")
  endif()
  set(response "${result}" PARENT_SCOPE)
endfunction()

set(manifest "${project}/wds.project.json")
set(scene "${project}/assets/motion.json")
file(SHA256 "${manifest}" manifest_before)
file(SHA256 "${scene}" scene_before)
set(edit [=[{"operation":"scene.field.set","version":1,"expected_revision":0,"request_id":"w10","input":{"entity_id":"marker","field":"x","value":-240}}]=])

string(JSON preview SET "${edit}" mode [=["preview"]=])
request(ok "${preview}")
string(JSON identity GET "${response}" request_id)
string(JSON measured GET "${response}" usage elapsed_ms)
if(NOT identity STREQUAL "w10" OR measured LESS 0)
  message(FATAL_ERROR "Request identity or elapsed time missing: ${response}")
endif()
string(JSON plain REMOVE "${response}" usage)
string(JSON plain REMOVE "${plain}" request_id)
execute_process(COMMAND "${CLI}" project preview-scene-field "${project}" marker x 0 -240
  RESULT_VARIABLE status OUTPUT_VARIABLE legacy ENCODING UTF-8)
string(JSON same EQUAL "${legacy}" "${plain}")
if(NOT status STREQUAL "0" OR NOT same)
  message(FATAL_ERROR "Legacy and JSON preview differ: ${legacy}${response}")
endif()

string(JSON cancel SET "${edit}" mode [=["cancel"]=])
request(cancelled "${cancel}")
string(JSON apply SET "${edit}" mode [=["apply"]=])
request(permission_denied "${apply}")
string(JSON invalid SET "${apply}" input value [=["42"]=])
request(invalid_argument "${invalid}" --allow-project-write)
request(invalid_argument [=[{"operation":"project.index","version":1,"mode":"read","input":{"directory":"elsewhere"}}]=])
file(SHA256 "${manifest}" manifest_after)
file(SHA256 "${scene}" scene_after)
if(NOT manifest_before STREQUAL manifest_after OR NOT scene_before STREQUAL scene_after)
  message(FATAL_ERROR "Preview, cancellation or a rejected write changed the project")
endif()
