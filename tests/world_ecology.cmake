cmake_minimum_required(VERSION 3.25)
string(RANDOM LENGTH 12 nonce)
set(root "${ROOT}/${nonce}")
file(MAKE_DIRECTORY "${root}")
file(COPY "${EXAMPLES}/frontier" "${EXAMPLES}/wetlands" DESTINATION "${root}")
set(frontier "${root}/frontier")
set(wetlands "${root}/wetlands")

function(request project expected payload)
  file(WRITE "${root}/request.json" "${payload}")
  execute_process(COMMAND "${CLI}" project request "${project}" --allow-project-write
    INPUT_FILE "${root}/request.json"
    RESULT_VARIABLE status OUTPUT_VARIABLE reply ERROR_VARIABLE detail ENCODING UTF-8)
  string(JSON code ERROR_VARIABLE parse GET "${reply}" code)
  if(parse OR NOT code STREQUAL expected OR (code STREQUAL "ok" AND NOT status STREQUAL "0"))
    message(FATAL_ERROR "Expected ${expected}, received ${reply} ${detail}")
  endif()
  set(reply "${reply}" PARENT_SCOPE)
endfunction()

request("${frontier}" ok [=[{"version":1,"operation":"scene.landscape.sample","mode":"read","expected_revision":0,"input":{"x":31,"z":32}}]=])
string(JSON monument GET "${reply}" landmark)
string(JSON cells LENGTH "${reply}" blocks)
if(NOT monument STREQUAL "hamlet" OR NOT cells EQUAL 12)
  message(FATAL_ERROR "Invalid frontier result: ${reply}")
endif()

set(play [=[{"version":1,"operation":"project.play","mode":"read","expected_revision":0,"input":{"ticks":10,"keys":["D"]}}]=])
request("${wetlands}" ok "${play}")
string(JSON original REMOVE "${reply}" usage)
string(JSON start_x GET "${original}" entities 0 x)
string(JSON selected GET "${original}" ecology character id)
if(NOT start_x EQUAL 48 OR NOT selected STREQUAL "observer")
  message(FATAL_ERROR "Original profile not used: ${reply}")
endif()

set(preview [=[{"version":1,"operation":"scene.character.set","mode":"preview","expected_revision":0,"input":{"id":"courier","speed":13,"sight":7,"capture_change":true}}]=])
request("${wetlands}" ok "${preview}")
request("${wetlands}" ok "${play}")
string(JSON replay REMOVE "${reply}" usage)
if(NOT replay STREQUAL original)
  message(FATAL_ERROR "Preview changed the project or the replay result")
endif()
request("${wetlands}" invalid_terrain [=[{"version":1,"operation":"scene.character.set","mode":"apply","expected_revision":0,"input":{"id":"courier","speed":129}}]=])
string(JSON location GET "${reply}" location)
if(NOT location STREQUAL "/terrain/ecology/characters/1/speed")
  message(FATAL_ERROR "Invalid speed diagnostic lacks field path: ${reply}")
endif()
string(REPLACE "\"preview\"" "\"apply\"" apply "${preview}")
request("${wetlands}" ok "${apply}")
string(JSON change GET "${reply}" scene_change)
request("${wetlands}" revision_conflict "${apply}")

string(REPLACE "\"expected_revision\":0" "\"expected_revision\":1" next_play "${play}")
request("${wetlands}" ok "${next_play}")
string(JSON renewed_x GET "${reply}" entities 0 x)
string(JSON speed GET "${reply}" ecology character speed)
string(JSON sight GET "${reply}" ecology character sight)
if(NOT renewed_x EQUAL 138 OR NOT speed EQUAL 13 OR NOT sight EQUAL 7)
  message(FATAL_ERROR "Character edits failed after reopening: ${reply}")
endif()
string(JSON before GET "${change}" before)
string(JSON after GET "${change}" after)
get_filename_component(scene "${wetlands}/assets/wetlands.json" ABSOLUTE)
file(READ "${scene}" persisted)
if(before STREQUAL after OR NOT persisted STREQUAL after)
  message(FATAL_ERROR "Captured edit differs from persisted data")
endif()

execute_process(COMMAND "${PROBE}" "${frontier}" RESULT_VARIABLE status)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "World and ecology probe returned ${status}")
endif()
