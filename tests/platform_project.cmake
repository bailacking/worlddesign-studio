execute_process(COMMAND "${CLI}" --project-operations RESULT_VARIABLE status OUTPUT_VARIABLE registry)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Project operation discovery failed")
endif()
set(expected_ids
  behavior.convert circuit.replay expedition.replay
  project.create project.diff project.export project.imports project.index project.open
  project.play project.recover project.resources project.validate
  resource.field.preview resource.field.set resource.import.apply resource.import.preview
  scene.character.set scene.entity.apply scene.entity.preview scene.field.preview scene.field.set
  scene.inspect scene.landscape.environment scene.landscape.sample scene.navigate scene.palette.set scene.restore scene.tile.set scene.voxel.actuate
)
set(writers
  project.create project.recover resource.field.set resource.import.apply scene.field.set
  scene.character.set scene.entity.apply scene.palette.set scene.restore scene.tile.set scene.voxel.actuate
)
list(LENGTH expected_ids expected_count)
string(JSON declared LENGTH "${registry}" operations)
if(NOT declared EQUAL expected_count)
  message(FATAL_ERROR "Expected ${expected_count} project operations, got ${declared}")
endif()
math(EXPR last_operation "${declared} - 1")
foreach(index RANGE ${last_operation})
  string(JSON operation GET "${registry}" operations ${index})
  string(JSON id GET "${operation}" id)
  string(JSON version GET "${operation}" version)
  string(JSON writes GET "${operation}" writes_project)
  list(FIND writers "${id}" writer)
  if(NOT version EQUAL 1 OR (writer GREATER_EQUAL 0 AND NOT writes) OR
      (writer LESS 0 AND writes))
    message(FATAL_ERROR "Incorrect operation metadata: ${operation}")
  endif()
  list(APPEND ids "${id}")
  if(id STREQUAL "project.export")
    string(JSON writes_destination GET "${operation}" writes_destination)
    if(NOT writes_destination)
      message(FATAL_ERROR "Export must declare its destination write: ${operation}")
    endif()
  endif()
endforeach()
list(SORT ids)
if(NOT ids STREQUAL expected_ids)
  message(FATAL_ERROR "Unexpected operation IDs: ${ids}")
endif()

function(check expected)
  execute_process(
    COMMAND "${CLI}" project ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE detail
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

file(READ "${FIXTURES}/cases.json" cases)
string(JSON count LENGTH "${cases}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${cases}" ${index} case)
  string(JSON expected GET "${cases}" ${index} expected)
  set(directory "${FIXTURES}/${name}")
  file(SHA256 "${directory}/wds.project.json" before)
  check("${expected}" validate "${directory}")
  file(SHA256 "${directory}/wds.project.json" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Validation modified ${name}")
  endif()
endforeach()

