file(MAKE_DIRECTORY "${ROOT}")

execute_process(COMMAND "${CLI}" --project-operations RESULT_VARIABLE status OUTPUT_VARIABLE registry)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Project operation discovery failed")
endif()
string(JSON declared LENGTH "${registry}" operations)
if(NOT declared EQUAL 4)
  message(FATAL_ERROR "Unexpected number of project operations")
endif()
foreach(index RANGE 0 3)
  string(JSON operation GET "${registry}" operations ${index})
  string(JSON id GET "${operation}" id)
  string(JSON version GET "${operation}" version)
  string(JSON writes GET "${operation}" writes_project)
  if(NOT version EQUAL 1 OR (id STREQUAL "project.create" AND NOT writes) OR
      (NOT id STREQUAL "project.create" AND writes))
    message(FATAL_ERROR "Incorrect operation metadata: ${operation}")
  endif()
  list(APPEND ids "${id}")
endforeach()
list(SORT ids)
if(NOT ids STREQUAL "project.create;project.open;project.resources;project.validate")
  message(FATAL_ERROR "Unexpected operation IDs: ${ids}")
endif()

function(check expected)
  execute_process(
    COMMAND "${CLI}" project ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE detail
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

file(READ "${FIXTURES}/cases.json" cases)
string(JSON count LENGTH "${cases}")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${cases}" ${index} case)
  string(JSON expected GET "${cases}" ${index} expected)
  set(directory "${FIXTURES}/${name}")
  file(SHA256 "${directory}/wds.project.json" before)
  check("${expected}" validate "${directory}")
  file(SHA256 "${directory}/wds.project.json" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Validation modified ${name}")
  endif()
endforeach()

string(RANDOM LENGTH 12 nonce)
set(project "${ROOT}/测试 ${nonce}")
check(ok create "${project}" demo-01)
set(created "${result}")
check(ok open "${project}")
if(NOT result STREQUAL created)
  message(FATAL_ERROR "Reopen returned a different project")
endif()
check(already_exists create "${project}" other)
check(ok validate "${project}")
if(NOT result STREQUAL created)
  message(FATAL_ERROR "Duplicate create overwrote project")
endif()
check(ok resources "${FIXTURES}/valid-with-refs")
string(JSON resource_count LENGTH "${result}" resources)
string(JSON reference GET "${result}" resources 0 refs 0)
if(NOT resource_count EQUAL 2 OR NOT reference STREQUAL "rules")
  message(FATAL_ERROR "Resource query lost identity or references: ${result}")
endif()
set(manifest "${project}/wds.project.json")
file(READ "${manifest}" original)
string(REPLACE "\"revision\": 0" "\"revision\": 0, \"revision\": 1" duplicate "${original}")
file(WRITE "${manifest}" "${duplicate}")
check(invalid_manifest validate "${project}")
string(REPLACE "\"revision\": 0" "\"revision\": 1e0" exponent "${original}")
file(WRITE "${manifest}" "${exponent}")
check(invalid_manifest validate "${project}")
string(REPLACE "\"revision\": 0" "\"revision\": 9007199254740992" large "${original}")
file(WRITE "${manifest}" "${large}")
check(invalid_manifest validate "${project}")
string(ASCII 255 invalid_byte)
file(WRITE "${manifest}" "{\"invalid\":\"${invalid_byte}\"}")
check(invalid_manifest validate "${project}")
file(WRITE "${manifest}" "${original}")
file(RENAME "${project}/assets/intro.json" "${project}/assets/INTRO.json.tmp")
file(RENAME "${project}/assets/INTRO.json.tmp" "${project}/assets/INTRO.json")
check(unsafe_path validate "${project}")
