function(quote name)
  string(REPLACE "\\" "\\\\" encoded "${${name}}")
  string(REPLACE "\"" "\\\"" encoded "${encoded}")
  string(REPLACE "\n" "\\n" encoded "${encoded}")
  string(REPLACE "\r" "\\r" encoded "${encoded}")
  string(REPLACE "\t" "\\t" encoded "${encoded}")
  set(${name}_quoted "\"${encoded}\"" PARENT_SCOPE)
endfunction()

foreach(name IN ITEMS before_manifest after_manifest before_data after_data)
  quote(${name})
endforeach()
set(record "{\"version\":1,\"resource\":\"rules\",\"field\":\"jump_speed\",\"before_manifest\":${before_manifest_quoted},\"after_manifest\":${after_manifest_quoted},\"before_data\":${before_data_quoted},\"after_data\":${after_data_quoted}}")

foreach(phase IN ITEMS staged_only published data_replaced committed)
  file(CONFIGURE OUTPUT "${manifest}" CONTENT "${before_manifest}" @ONLY NEWLINE_STYLE UNIX)
  file(CONFIGURE OUTPUT "${data}" CONTENT "${before_data}" @ONLY NEWLINE_STYLE UNIX)
  if(phase STREQUAL "staged_only")
    file(WRITE "${staging}" "incomplete")
  else()
    file(WRITE "${journal}" "${record}")
  endif()
  if(phase STREQUAL "data_replaced" OR phase STREQUAL "committed")
    file(CONFIGURE OUTPUT "${data}" CONTENT "${after_data}" @ONLY NEWLINE_STYLE UNIX)
  endif()
  if(phase STREQUAL "committed")
    file(CONFIGURE OUTPUT "${manifest}" CONTENT "${after_manifest}" @ONLY NEWLINE_STYLE UNIX)
    set(want 1)
    set(want_data "${after_data}")
  else()
    set(want 0)
    set(want_data "${before_data}")
  endif()
  check(recovery_required validate "${project}")
  check(ok recover "${project}")
  check(ok recover "${project}")
  string(JSON revision GET "${result}" revision)
  file(READ "${data}" recovered)
  if(NOT revision EQUAL want OR NOT recovered STREQUAL want_data OR
     EXISTS "${journal}" OR EXISTS "${staging}")
    message(FATAL_ERROR "Incorrect recovery: ${phase}")
  endif()
endforeach()

file(WRITE "${manifest}" "${before_manifest}")
