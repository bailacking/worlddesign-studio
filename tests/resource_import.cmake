# PRD-05 资源导入回归：用「四方汇流」副本验证预览、提交、重复导入、冲突与中断恢复。
file(MAKE_DIRECTORY "${ROOT}")
string(RANDOM LENGTH 12 nonce)
set(sources "${ROOT}/sources-${nonce}")
file(MAKE_DIRECTORY "${sources}")

function(check expected)
  execute_process(
    COMMAND "${CLI}" project ${ARGN}
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE detail
    ENCODING UTF-8
  )
  string(JSON code ERROR_VARIABLE parse_error GET "${output}" code)
  if(parse_error OR NOT code STREQUAL expected OR
      (expected STREQUAL "ok" AND NOT status STREQUAL "0") OR
      (NOT expected STREQUAL "ok" AND NOT status STREQUAL "1"))
    message(FATAL_ERROR "Expected ${expected}: ${status} ${output} ${detail}")
  endif()
  set(result "${output}" PARENT_SCOPE)
endfunction()

function(quote name)
  string(REPLACE "\\" "\\\\" encoded "${${name}}")
  string(REPLACE "\"" "\\\"" encoded "${encoded}")
  string(REPLACE "\n" "\\n" encoded "${encoded}")
  string(REPLACE "\r" "\\r" encoded "${encoded}")
  string(REPLACE "\t" "\\t" encoded "${encoded}")
  set(${name}_quoted "\"${encoded}\"" PARENT_SCOPE)
endfunction()

set(project "${ROOT}/四方汇流导入 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${project}")
set(manifest "${project}/wds.project.json")
set(provenance "${project}/.wds-imports.json")
set(journal "${project}/.wds-field-edit.json")
set(staging "${project}/.wds-field-edit.tmp")
set(target "${project}/assets/notes.json")

set(source_content "{\"title\":\"四方汇流备注\",\"limit\":30}")
file(WRITE "${sources}/notes.json" "${source_content}")
file(WRITE "${sources}/other.json" "{\"title\":\"不同内容\",\"limit\":30}\n")
file(WRITE "${sources}/bad-scene.json" "{\"format_version\":1,\"entities\":[{\"id\":\"BAD\"}]}\n")
file(WRITE "${sources}/bad-data.json" "{\"ratio\":1.5}\n")
string(REPEAT "x" 1048577 oversized)
file(WRITE "${sources}/oversized.json" "${oversized}")

check(ok validate "${project}")
file(READ "${manifest}" manifest_before)
file(SHA256 "${project}/assets/field.json" scene_before)

# 预览不落盘，返回身份、目标、字节数和稳定诊断。
check(ok preview-import "${project}" "${sources}/notes.json" notes data assets/notes.json 0)
string(JSON changed GET "${result}" changed)
string(JSON revision GET "${result}" revision)
string(JSON size GET "${result}" bytes)
string(JSON resource_id GET "${result}" resource_id)
string(JSON preview_digest GET "${result}" digest)
file(SIZE "${sources}/notes.json" source_size)
if(NOT changed OR NOT revision EQUAL 0 OR NOT resource_id STREQUAL "notes" OR
   NOT size EQUAL source_size)
  message(FATAL_ERROR "Preview lost import identity: ${result}")
endif()
file(READ "${manifest}" manifest_after_preview)
file(SHA256 "${project}/assets/field.json" scene_after_preview)
if(NOT manifest_after_preview STREQUAL manifest_before OR NOT scene_after_preview STREQUAL scene_before OR
   EXISTS "${target}" OR EXISTS "${provenance}" OR EXISTS "${journal}" OR EXISTS "${staging}")
  message(FATAL_ERROR "Preview wrote to the project")
endif()

# 预览后被外部修改的源文件不能通过确认提交。
file(WRITE "${sources}/notes.json" "{\"limit\":31}")
check(source_changed import "${project}" "${sources}/notes.json" notes data assets/notes.json 0
  --expect-digest "${preview_digest}")
file(READ "${manifest}" manifest_after_source_change)
if(NOT manifest_after_source_change STREQUAL manifest_before OR EXISTS "${target}" OR
   EXISTS "${provenance}" OR EXISTS "${journal}")
  message(FATAL_ERROR "Changed source left a project write")
endif()
file(WRITE "${sources}/notes.json" "${source_content}")

# 提交写入原字节、追加清单条目、记录来源，并提升一个修订。
check(ok import "${project}" "${sources}/notes.json" notes data assets/notes.json 0
  --expect-digest "${preview_digest}")
string(JSON changed GET "${result}" changed)
string(JSON revision GET "${result}" revision)
if(NOT changed OR NOT revision EQUAL 1)
  message(FATAL_ERROR "Import did not commit: ${result}")
endif()
file(READ "${target}" imported_bytes)
file(SHA256 "${project}/assets/field.json" scene_after_import)
if(NOT imported_bytes STREQUAL source_content OR NOT scene_after_import STREQUAL scene_before)
  message(FATAL_ERROR "Import changed source bytes or another resource")
endif()
if(EXISTS "${journal}" OR EXISTS "${staging}")
  message(FATAL_ERROR "Import left a transaction record")
endif()
file(READ "${provenance}" provenance_committed)
file(READ "${manifest}" manifest_committed)

check(ok open "${project}")
string(JSON revision GET "${result}" revision)
string(JSON count GET "${result}" resource_count)
if(NOT revision EQUAL 1 OR NOT count EQUAL 3)
  message(FATAL_ERROR "Reopen lost the imported resource: ${result}")
endif()
check(ok resources "${project}")
string(JSON notes_path GET "${result}" resources 2 path)
string(JSON notes_kind GET "${result}" resources 2 kind)
if(NOT notes_path STREQUAL "assets/notes.json" OR NOT notes_kind STREQUAL "data")
  message(FATAL_ERROR "Resource listing lost the import: ${result}")
endif()
check(ok imports "${project}")
string(JSON import_count GET "${result}" count)
string(JSON source_name GET "${result}" imports 0 source_name)
string(JSON digest GET "${result}" imports 0 digest)
string(SUBSTRING "${digest}" 0 8 digest_prefix)
if(NOT import_count EQUAL 1 OR NOT source_name STREQUAL "notes.json" OR
   NOT digest_prefix STREQUAL "fnv1a64:")
  message(FATAL_ERROR "Provenance record is incomplete: ${result}")
endif()

# 同 ID、同路径、同字节重复导入返回无变化，修订与清单都不动。
check(ok import "${project}" "${sources}/notes.json" notes data assets/notes.json 1)
string(JSON changed GET "${result}" changed)
string(JSON revision GET "${result}" revision)
file(READ "${manifest}" manifest_after_repeat)
if(changed OR NOT revision EQUAL 1 OR NOT manifest_after_repeat STREQUAL manifest_committed)
  message(FATAL_ERROR "Repeat import was not a no-op: ${result}")
endif()

# 冲突：同 ID 不同字节、同路径不同 ID、同 ID 不同路径，都保留已有资源。
check(duplicate_id import "${project}" "${sources}/other.json" notes data assets/notes.json 1)
file(READ "${target}" after_conflict)
if(NOT after_conflict STREQUAL source_content)
  message(FATAL_ERROR "Conflicting import overwrote the resource")
endif()
check(duplicate_path import "${project}" "${sources}/other.json" extra data assets/notes.json 1)
check(duplicate_id import "${project}" "${sources}/notes.json" notes data assets/notes-copy.json 1)
check(revision_conflict import "${project}" "${sources}/notes.json" notes data assets/notes.json 0)
string(JSON current GET "${result}" revision)
if(NOT current EQUAL 1)
  message(FATAL_ERROR "Stale revision did not report the current revision: ${result}")
endif()

# 目标路径规则、源文件与内容校验。
check(invalid_path preview-import "${project}" "${sources}/other.json" extra data assets/../x.json 1)
check(invalid_path preview-import "${project}" "${sources}/other.json" extra data assets/Notes.json 1)
check(invalid_path preview-import "${project}" "${sources}/other.json" extra data assets/con.json 1)
check(invalid_source preview-import "${project}" "${sources}/missing.json" extra data assets/x.json 1)
check(invalid_argument preview-import "${project}" "${sources}/other.json" extra audio assets/x.json 1)
check(invalid_argument preview-import "${project}" "${sources}/other.json" Bad_ID data assets/x.json 1)
check(invalid_content preview-import "${project}" "${sources}/bad-scene.json" bad scene assets/bad.json 1)
check(invalid_content preview-import "${project}" "${sources}/bad-data.json" bad data assets/bad.json 1)
check(source_too_large preview-import "${project}" "${sources}/oversized.json" extra data assets/big.json 1)

# 目标位置已有不属于本项目的文件时报告占用，内容保持不变。
file(WRITE "${project}/assets/orphan.json" "{\"keep\":1}\n")
check(target_exists import "${project}" "${sources}/notes.json" orphan data assets/orphan.json 1)
file(READ "${project}/assets/orphan.json" orphan_after)
file(READ "${manifest}" manifest_after_failures)
file(READ "${provenance}" provenance_after_failures)
if(NOT orphan_after STREQUAL "{\"keep\":1}\n" OR NOT manifest_after_failures STREQUAL manifest_committed OR
   NOT provenance_after_failures STREQUAL provenance_committed)
  message(FATAL_ERROR "Failed import changed the project")
endif()

# 中断恢复：清单是提交点，目标是本次新建的文件与来源记录。
# 现场文件一律用 COPY_FILE 放置，避免 CMake 文本写入改变换行。
set(pristine "${ROOT}/四方汇流初始 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${pristine}")
set(seed "${ROOT}/四方汇流样本 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${seed}")
check(ok import "${seed}" "${sources}/notes.json" notes data assets/notes.json 0)
file(READ "${pristine}/wds.project.json" manifest_zero)
file(READ "${seed}/wds.project.json" manifest_committed)
file(READ "${seed}/assets/notes.json" data_after)
file(READ "${seed}/.wds-imports.json" provenance_after)

set(recovered "${ROOT}/四方汇流恢复 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${recovered}")
set(manifest_r "${recovered}/wds.project.json")
set(provenance_r "${recovered}/.wds-imports.json")
set(journal_r "${recovered}/.wds-field-edit.json")
set(staging_r "${recovered}/.wds-field-edit.tmp")
set(target_r "${recovered}/assets/notes.json")

foreach(name IN ITEMS manifest_zero manifest_committed data_after provenance_after)
  quote(${name})
endforeach()
set(record "{\"version\":5,\"resource\":\"notes\",\"kind\":\"data\",\"path\":\"assets/notes.json\",\"before_manifest\":${manifest_zero_quoted},\"after_manifest\":${manifest_committed_quoted},\"before_provenance\":\"\",\"after_provenance\":${provenance_after_quoted},\"after_data\":${data_after_quoted}}")

function(reset_before)
  file(COPY_FILE "${pristine}/wds.project.json" "${manifest_r}")
  file(REMOVE "${target_r}" "${provenance_r}" "${journal_r}" "${staging_r}")
endfunction()

foreach(phase IN ITEMS staged_only data_written provenance_written committed)
  reset_before()
  if(phase STREQUAL "staged_only")
    file(WRITE "${staging_r}" "incomplete")
  else()
    file(WRITE "${journal_r}" "${record}")
    file(COPY_FILE "${seed}/assets/notes.json" "${target_r}")
  endif()
  if(phase STREQUAL "provenance_written" OR phase STREQUAL "committed")
    file(COPY_FILE "${seed}/.wds-imports.json" "${provenance_r}")
  endif()
  if(phase STREQUAL "committed")
    file(COPY_FILE "${seed}/wds.project.json" "${manifest_r}")
    set(want 1)
  else()
    set(want 0)
  endif()
  check(recovery_required validate "${recovered}")
  check(ok recover "${recovered}")
  check(ok recover "${recovered}")
  string(JSON revision GET "${result}" revision)
  if(NOT revision EQUAL want)
    message(FATAL_ERROR "Recovery returned revision ${revision} at ${phase}")
  endif()
  if(want EQUAL 1)
    file(READ "${target_r}" recovered_data)
    file(READ "${provenance_r}" recovered_provenance)
    if(NOT recovered_data STREQUAL data_after OR NOT recovered_provenance STREQUAL provenance_after)
      message(FATAL_ERROR "Committed recovery lost the import")
    endif()
  elseif(EXISTS "${target_r}" OR EXISTS "${provenance_r}")
    message(FATAL_ERROR "Rollback kept the imported file at ${phase}")
  endif()
  if(EXISTS "${journal_r}" OR EXISTS "${staging_r}")
    message(FATAL_ERROR "Recovery left a transaction record at ${phase}")
  endif()
endforeach()

# 目标内容归属不明时保留现场并报告，不静默覆盖或删除。
reset_before()
file(WRITE "${journal_r}" "${record}")
file(WRITE "${target_r}" "{\"touched\":\"外部改写\"}
")
check(recovery_required recover "${recovered}")
file(READ "${target_r}" retained)
if(NOT retained STREQUAL "{\"touched\":\"外部改写\"}
" OR NOT EXISTS "${journal_r}")
  message(FATAL_ERROR "Recovery overwrote an unknown target")
endif()

# 清单已发布但目标文件缺失时同样停止写入。
reset_before()
file(WRITE "${journal_r}" "${record}")
file(COPY_FILE "${seed}/.wds-imports.json" "${provenance_r}")
file(COPY_FILE "${seed}/wds.project.json" "${manifest_r}")
check(recovery_required recover "${recovered}")
if(NOT EXISTS "${journal_r}" OR EXISTS "${target_r}")
  message(FATAL_ERROR "Recovery ignored a missing committed target")
endif()

# W5：老项目直接导入 PNG 和 UTF-8，保存原字节，预览返回适配器元数据。
set(asset_fixture "${CMAKE_CURRENT_LIST_DIR}/fixtures/asset-import")
set(asset_project "${ROOT}/图文资源 ${nonce}")
file(COPY "${EXAMPLE}/" DESTINATION "${asset_project}")
set(asset_manifest "${asset_project}/wds.project.json")
set(asset_provenance "${asset_project}/.wds-imports.json")
set(image_source "${asset_fixture}/tile.png")
set(image_target "${asset_project}/assets/tile.png")
set(text_source "${sources}/图文说明.txt")
set(text_body "礁灯\n第二行\r末行")
string(ASCII 239 187 191 bom)
file(WRITE "${text_source}" "${bom}${text_body}")

check(ok preview-import "${asset_project}" "${image_source}" tile image assets/tile.png 0)
string(JSON width GET "${result}" width)
string(JSON height GET "${result}" height)
string(JSON image_digest GET "${result}" digest)
if(NOT width EQUAL 192 OR NOT height EQUAL 96 OR EXISTS "${image_target}")
  message(FATAL_ERROR "PNG preview lost dimensions or wrote a file: ${result}")
endif()

check(ok import "${asset_project}" "${image_source}" tile image assets/tile.png 0
  --expect-digest "${image_digest}")
file(SHA256 "${image_source}" image_hash)
file(SHA256 "${image_target}" imported_image_hash)
file(READ "${asset_manifest}" binary_manifest)
file(READ "${asset_provenance}" binary_provenance)
file(COPY_FILE "${asset_manifest}" "${sources}/png-committed-manifest.json")
file(COPY_FILE "${asset_provenance}" "${sources}/png-committed-provenance.json")
if(NOT image_hash STREQUAL imported_image_hash)
  message(FATAL_ERROR "PNG import changed the source bytes")
endif()

check(ok preview-import "${asset_project}" "${text_source}" notes text assets/notes.txt 1)
string(JSON line_count GET "${result}" line_count)
string(JSON text_preview GET "${result}" text_preview)
if(NOT line_count EQUAL 3 OR NOT text_preview STREQUAL "礁灯\n第二行\n末行")
  message(FATAL_ERROR "UTF-8 preview did not normalize BOM and newline sequences: ${result}")
endif()
check(ok import "${asset_project}" "${text_source}" notes text assets/notes.txt 1)
file(SHA256 "${text_source}" original_text_hash)
file(SHA256 "${asset_project}/assets/notes.txt" imported_text_hash)
if(NOT imported_text_hash STREQUAL original_text_hash)
  message(FATAL_ERROR "Text import changed the source bytes")
endif()

check(ok resources "${asset_project}")
string(JSON resource_count LENGTH "${result}" resources)
string(JSON final_revision GET "${result}" revision)
if(NOT resource_count EQUAL 4 OR NOT final_revision EQUAL 2)
  message(FATAL_ERROR "Reopen lost the assets or the project revision: ${result}")
endif()
check(ok import "${asset_project}" "${image_source}" tile image assets/tile.png 2)
string(JSON repeated GET "${result}" changed)
if(repeated)
  message(FATAL_ERROR "The same PNG imported twice")
endif()
check(revision_conflict import "${asset_project}" "${text_source}" more text assets/more.txt 1)
check(duplicate_id preview-import "${asset_project}" "${image_source}" tile image assets/copy.png 2)
check(invalid_png preview-import "${asset_project}" "${asset_fixture}/truncated.png" bad image assets/bad.png 2)
string(ASCII 192 175 invalid_utf8)
file(WRITE "${sources}/bad.txt" "${invalid_utf8}")
check(invalid_utf8 preview-import "${asset_project}" "${sources}/bad.txt" bad text assets/bad.txt 2)
if(EXISTS "${asset_project}/assets/bad.png" OR EXISTS "${asset_project}/assets/bad.txt")
  message(FATAL_ERROR "Rejected inputs left a resource")
endif()

# PNG journal v6 stores hex and must recover binary bytes across the manifest commit point.
file(READ "${image_source}" image_hex HEX)
foreach(name IN ITEMS binary_manifest binary_provenance)
  quote(${name})
endforeach()
set(binary_record "{\"version\":6,\"resource\":\"tile\",\"kind\":\"image\",\"path\":\"assets/tile.png\",\"before_manifest\":${manifest_zero_quoted},\"after_manifest\":${binary_manifest_quoted},\"before_provenance\":\"\",\"after_provenance\":${binary_provenance_quoted},\"after_data\":\"${image_hex}\"}")
foreach(phase IN ITEMS rollback committed)
  set(binary_project "${ROOT}/PNG恢复-${phase}-${nonce}")
  file(COPY "${EXAMPLE}/" DESTINATION "${binary_project}")
  file(COPY_FILE "${image_source}" "${binary_project}/assets/tile.png")
  file(WRITE "${binary_project}/.wds-field-edit.json" "${binary_record}")
  file(COPY_FILE "${sources}/png-committed-provenance.json" "${binary_project}/.wds-imports.json")
  if(phase STREQUAL "committed")
    file(COPY_FILE "${sources}/png-committed-manifest.json" "${binary_project}/wds.project.json")
  endif()
  check(ok recover "${binary_project}")
  string(JSON recovered_revision GET "${result}" revision)
  if(phase STREQUAL "committed")
    file(SHA256 "${binary_project}/assets/tile.png" recovered_image_hash)
    if(NOT recovered_revision EQUAL 1 OR NOT recovered_image_hash STREQUAL image_hash)
      message(FATAL_ERROR "PNG commit recovery lost the original image")
    endif()
  elseif(NOT recovered_revision EQUAL 0 OR EXISTS "${binary_project}/assets/tile.png" OR
         EXISTS "${binary_project}/.wds-imports.json")
    message(FATAL_ERROR "PNG rollback retained imported state")
  endif()
  if(EXISTS "${binary_project}/.wds-field-edit.json")
    message(FATAL_ERROR "PNG recovery left a pending journal")
  endif()
endforeach()
