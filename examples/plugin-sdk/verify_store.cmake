cmake_minimum_required(VERSION 3.20)

string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(store "${CMAKE_CURRENT_BINARY_DIR}/palette-store-${suffix}")
file(MAKE_DIRECTORY "${store}")

function(check exit substring)
  execute_process(
    COMMAND "${DEMO}" ${ARGN}
    OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE actual TIMEOUT 10)
  if(NOT actual STREQUAL "${exit}" OR NOT "${output}${error}" MATCHES "${substring}")
    message(FATAL_ERROR "Unexpected palette result ${actual}\n${output}${error}")
  endif()
endfunction()

check(0 "526980" --preview "${store}")
check(0 "" --install "${store}" "${DAYLIGHT}")
check(0 "5269c0" --preview "${store}")
check(0 "" --install "${store}" "${OVERCAST}")
check(0 "526960" --preview "${store}")
check(5 "abi_mismatch" --install "${store}" "${OBSOLETE}")
check(0 "526960" --preview "${store}")
check(0 "" --remove "${store}")
check(0 "526980" --preview "${store}")
if(NOT EXISTS "${DAYLIGHT}" OR NOT EXISTS "${OVERCAST}" OR NOT EXISTS "${OBSOLETE}")
  message(FATAL_ERROR "Plugin management changed a source module")
endif()
file(GLOB leftovers "${store}/*" "${store}/.*")
if(leftovers)
  message(FATAL_ERROR "Palette store retained files after uninstall")
endif()
file(REAL_PATH "${store}" resolved)
file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" build)
cmake_path(IS_PREFIX build "${resolved}" NORMALIZE inside)
if(NOT inside OR resolved STREQUAL build)
  message(FATAL_ERROR "Palette test directory escaped the build directory")
endif()
file(REMOVE_RECURSE "${resolved}")
